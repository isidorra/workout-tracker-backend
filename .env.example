ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=workout_tracker_db;Username=postgres;Password=postgres

Jwt__Issuer=workout-tracker
Jwt__Audience=workout-tracker
# At least 32 bytes; generate one with: openssl rand -hex 32
Jwt__SigningKey=replace-me-with-at-least-32-random-bytes
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
